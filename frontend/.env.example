# ── Backend API URL ───────────────────────────────────────────────────────────
# Set this to your Render backend URL after deploying
REACT_APP_API_URL=https://blindspot-api.onrender.com

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
REACT_APP_SUPABASE_URL=https://<your-ref>.supabase.co
REACT_APP_SUPABASE_ANON_KEY=<your-anon-key>
