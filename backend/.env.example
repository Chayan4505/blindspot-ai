# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-service_role-key>       # NOT the anon key
SUPABASE_STORAGE_BUCKET=project-seeds

# ── Database ──────────────────────────────────────────────────────────────────
# Get from: Supabase dashboard → Project Settings → Database → Connection string (URI)
# Use the "Session mode" URI (port 5432), NOT transaction mode
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ── API base URL (used to build public media URLs in local dev) ───────────────
API_BASE_URL=http://localhost:8000

# ── ML Settings ───────────────────────────────────────────────────────────────
MOCK_ML=true
IMAGES_PER_STRESSOR=8
USE_BLENDER=false
BLENDER_PATH=/usr/bin/blender

# ── Generated image temp dir ──────────────────────────────────────────────────
# Local dev: leave unset (defaults to backend/data/generated)
# Render:    /tmp/generated
# GENERATED_DIR=/tmp/generated

# ── Gemini / AI ───────────────────────────────────────────────────────────────
GOOGLE_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-1.5-flash

# ── Redis (only needed if running real Celery workers) ────────────────────────
# REDIS_URL=redis://localhost:6379/0
